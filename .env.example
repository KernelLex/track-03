# Copy to .env and fill in. Never commit the real .env — it's gitignored.
# Load into your shell before running anything: `source .env` (bash) or
# `Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }` (PowerShell).

# --- Razorpay (docs/SETUP.md) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TRUECOMMIT_WEBHOOK_SECRET_RAZORPAY=
TRUECOMMIT_EVENTS_DB=events.db
TRUECOMMIT_LEDGER_DB=ledger.db

# --- Claude API (docs/LLM_EXTRACTION.md) ---
# Powers agent/diagnose/llm_extract.py — Path B extraction from a debtor's
# free-text reply. Without this set, only Path A (structured event codes,
# no model needed) runs; Path B has no fallback that fabricates a diagnosis.
ANTHROPIC_API_KEY=
# Only needed for an identity-linked key (a 400 asking for
# "anthropic-workspace-id" means you have one) -- a plain workspace-scoped
# key doesn't need this at all. Console -> Workspaces -> copy its id.
ANTHROPIC_WORKSPACE_ID=
# Where real Path B extractions get logged for the Auditor's extractor-
# drift job to later sample (agent/auditor/extractor_drift.py). Not
# git-committed (raw debtor reply text). Defaults to extraction_log.db if
# unset -- only set this to point it somewhere else.
TRUECOMMIT_EXTRACTION_LOG=extraction_log.db

# --- Telegram (docs/CHANNELS.md) ---
# From @BotFather. The bot can only message a chat_id that has already
# messaged it first — see tools/telegram_get_chat_id.py.
TELEGRAM_BOT_TOKEN=

# --- Twilio (docs/CHANNELS.md) ---
# Voice calls only (the "ivr" channel) — the one channel in this project
# that costs money per use. Not used for SMS/WhatsApp; Telegram covers
# free messaging instead.
TWILIO_ACCOUNT_SID=
# Either the classic Auth Token (TWILIO_AUTH_TOKEN), or a Twilio API Key --
# leave AUTH_TOKEN blank and set both of these instead:
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# --- WhatsApp Business Cloud API (docs/WHATSAPP.md) ---
# The intended production channel once these exist -- preferred over
# Telegram automatically the moment both are set (agent/api/app.py).
# From Meta's App Dashboard -> WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# A different credential from the access token above -- the App's own
# secret (App Dashboard -> Settings -> Basic), used only to verify
# X-Hub-Signature-256 on inbound webhook deliveries.
WHATSAPP_APP_SECRET=
# Any string you choose -- entered again in the App Dashboard's webhook
# setup screen when registering this server's /webhooks/whatsapp URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Demo dashboard (agent/api/demo.py, docs/DEMO_UI.md) ---
# /demo/trigger can only ever message these two -- never a request-supplied
# recipient. DEMO_TRIGGER_SECRET is baked into the published Artifact's JS,
# so it's a soft guard, not a real auth boundary.
DEMO_TRIGGER_SECRET=
DEMO_CONTACT_TELEGRAM_CHAT_ID=
DEMO_CONTACT_PHONE_NUMBER=
# Telegram echoes this in X-Telegram-Bot-Api-Secret-Token on every webhook
# delivery to /demo/telegram-webhook. That endpoint is public, so without a
# match an unauthenticated caller could fabricate a debtor reply and make
# the system answer a message that was never sent. Generate any long random
# string, set it here AND in Telegram's setWebhook call -- they must match
# exactly. (A trailing character lost when pasting into a host's env-var UI
# produces a silent 403 on every delivery; see docs/WHAT_BROKE.md #15.)
TELEGRAM_WEBHOOK_SECRET=

# --- Durable state (all optional; each defaults to the filename shown) ---
# Under Turso these paths are ignored and every store shares one database
# (agent/db.py) -- this is a local-file distinction only.
# Conversation turns, the outstanding proposal, the handled-message claim
# table, and the dashboard's timeline (agent/notify/conversation.py).
TRUECOMMIT_CONVERSATION_DB=conversation.db
# The debtor register and their promise outcomes -- the history
# promise_credibility is computed from (agent/debtor/registry.py).
TRUECOMMIT_DEBTORS_DB=debtors.db

# Business timezone for every relative date ("today", "next Friday", the
# early-payment window). Defaults to IST (+05:30) -- the server's own
# clock is UTC on most hosts, which resolves "today" a day early for an
# Indian debtor texting between 00:00 and 05:30 IST (docs/WHAT_BROKE.md
# #20). Only set this for a deployment serving another country.
TRUECOMMIT_TIMEZONE_OFFSET_MINUTES=330

# --- Subscription demo: a second Telegram bot (docs/DEMO_UI.md) ---
# Separate from the b2b bot so the two demo conversations are visually
# distinct in Telegram. Its own webhook path
# (/demo/telegram-webhook/subscription) and its own secret, so a 403 says
# immediately which bot broke.
#
# NOTE: Telegram's private-chat id is the *user's* id, not a per-bot one --
# so this will usually be the SAME number as DEMO_CONTACT_TELEGRAM_CHAT_ID.
# The conversation store namespaces it ("sub:<id>") so the two threads do
# not merge; see SUBSCRIPTION_THREAD_PREFIX in agent/api/demo.py.
TELEGRAM_SUBSCRIPTION_BOT_TOKEN=
TELEGRAM_SUBSCRIPTION_WEBHOOK_SECRET=
DEMO_CONTACT_SUBSCRIPTION_CHAT_ID=
