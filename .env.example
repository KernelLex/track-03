# Copy to .env and fill in. Never commit the real .env — it's gitignored.
# Load into your shell before running anything: `source .env` (bash) or
# `Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }` (PowerShell).

# --- Razorpay (docs/SETUP.md) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TRUECOMMIT_WEBHOOK_SECRET_RAZORPAY=
TRUECOMMIT_EVENTS_DB=events.db
TRUECOMMIT_LEDGER_DB=ledger.db

# --- Claude API (docs/LLM_EXTRACTION.md) ---
# Powers agent/diagnose/llm_extract.py — Path B extraction from a debtor's
# free-text reply. Without this set, only Path A (structured event codes,
# no model needed) runs; Path B has no fallback that fabricates a diagnosis.
ANTHROPIC_API_KEY=

# --- Telegram (docs/CHANNELS.md) ---
# From @BotFather. The bot can only message a chat_id that has already
# messaged it first — see tools/telegram_get_chat_id.py.
TELEGRAM_BOT_TOKEN=

# --- Twilio (docs/CHANNELS.md) ---
# Voice calls only (the "ivr" channel) — the one channel in this project
# that costs money per use. Not used for SMS/WhatsApp; Telegram covers
# free messaging instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
